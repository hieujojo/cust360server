# ============================================================
# COPY file này thành .env và điền giá trị thật vào
# KHÔNG commit file .env lên git
# ============================================================

# Environment
ASPNETCORE_ENVIRONMENT=Development

# MongoDB Atlas Connection
# Lấy từ: MongoDB Atlas > Connect > Drivers
MongoDB__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>
MongoDB__DatabaseName=crm360

# JWT Settings
# Tạo secret ngẫu nhiên: openssl rand -base64 32
Jwt__Secret=<your-jwt-secret-min-32-chars>
Jwt__Issuer=crm360
Jwt__Audience=crm360-client
Jwt__AccessTokenExpiryMinutes=60

# Email (SMTP)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=<your-email@gmail.com>
Email__SmtpPassword=<your-app-password>
Email__EnableSsl=true
Email__FromAddress=noreply@crm360.vn
Email__FromName=CRM Customer 360

# Redis (để trống nếu chưa dùng)
ConnectionStrings__Redis=<redis-connection-string>

# CORS - URL của frontend
AllowedOrigins__0=https://your-frontend-domain.com

# Server
ASPNETCORE_URLS=http://0.0.0.0:5001
